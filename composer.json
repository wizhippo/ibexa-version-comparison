{
    "name": "wizhippo/ibexa-version-comparison",
    "description": "Independent read-only content version comparison for the Ibexa 5 admin UI.",
    "type": "symfony-bundle",
    "license": "GPL-2.0-only",
    "homepage": "https://github.com/wizhippo/ibexa-version-comparison",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-mbstring": "*",
        "ibexa/admin-ui": "^5.0",
        "ibexa/core": "^5.0",
        "ibexa/fieldtype-richtext": "^5.0",
        "knplabs/knp-menu": "^3.0",
        "psr/log": "^3.0",
        "sebastian/diff": "^4.0 || ^5.0 || ^6.0 || ^7.0",
        "symfony/framework-bundle": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/security-http": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Wizhippo\\IbexaVersionComparison\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wizhippo\\IbexaVersionComparison\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Douglas Hammond",
            "homepage": "https://github.com/wizhippo",
            "role": "Author and maintainer"
        },
        {
            "name": "LLM",
            "role": "AI-assisted development"
        }
    ]
}
